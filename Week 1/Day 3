function calculateGrade(score) {
  // Handle invalid types
  if (typeof score !== 'number' || Number.isNaN(score)) {
    return 'Invalid input';
  }

  // Handle out-of-range values
  if (score < 0 || score > 100) {
    return 'Score must be between 0 and 100';
  }

  // Grade logic
  if (score >= 90) {
    return 'A';
  } else if (score >= 80) {
    return 'B';
  } else if (score >= 70) {
    return 'C';
  } else if (score >= 60) {
    return 'D';
  } else {
    return 'F';
  }
}

// Tests (6 inputs)
console.log(calculateGrade(95));    // A
console.log(calculateGrade(82));    // B
console.log(calculateGrade(74));    // C
console.log(calculateGrade(61));    // D
console.log(calculateGrade(45));    // F
console.log(calculateGrade(-5));    // Score must be between 0 and 100

// Extra edge case tests
console.log(calculateGrade(150));   // Score must be between 0 and 100
console.log(calculateGrade("90"));  // Invalid input
console.log(calculateGrade(NaN));   // Invalid input
