// (a) FizzBuzz 1–100
for (let i = 1; i <= 100; i++) {
    if (i % 3 === 0 && i % 5 === 0) {
        console.log("FizzBuzz");
    } else if (i % 3 === 0) {
        console.log("Fizz");
    } else if (i % 5 === 0) {
        console.log("Buzz");
    } else {
        console.log(i);
    }
}


// (b) Sum of even numbers 1–50 using a for loop
let sum = 0;

for (let i = 1; i <= 50; i++) {
    if (i % 2 === 0) {
        sum += i;
    }
}

console.log("Sum of even numbers from 1 to 50:", sum);


// (c) Function that prints multiplication table
function multiplicationTable(number) {
    for (let i = 1; i <= 10; i++) {
        console.log(`${number} x ${i} = ${number * i}`);
    }
}

// Take input from prompt()
let userNumber = Number(prompt("Enter a number:"));
multiplicationTable(userNumber);
