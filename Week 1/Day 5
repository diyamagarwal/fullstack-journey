// (1) Grade calculator function
function getGrade(score) {

    // Handle invalid input type
    if (typeof score !== "number" || Number.isNaN(score)) {
        return "Invalid input";
    }

    // Handle out-of-range values
    if (score < 0 || score > 100) {
        return "Score must be between 0 and 100";
    }

    // Grade logic
    if (score >= 90) {
        return "A";
    } else if (score >= 80) {
        return "B";
    } else if (score >= 70) {
        return "C";
    } else if (score >= 60) {
        return "D";
    } else {
        return "F";
    }
}

// Test cases
console.log(getGrade(95));     // A
console.log(getGrade(82));     // B
console.log(getGrade(74));     // C
console.log(getGrade(61));     // D
console.log(getGrade(45));     // F
console.log(getGrade(-5));     // Score must be between 0 and 100
console.log(getGrade(150));    // Score must be between 0 and 100
console.log(getGrade("90"));   // Invalid input
console.log(getGrade(NaN));    // Invalid input



// (2) Age calculator function
function calculateAge(name, yob) {

    // Check for invalid year
    if (isNaN(yob)) {
        return "Enter proper year of birth";
    }

    const today = 2026;
    const age = today - yob;

    return `${name}'s age is ${age}`;
}

// Get input from user
let myName = prompt("What is your Name?");
let myYOB = Number(prompt("Enter your year of birth"));

// Show result
alert(calculateAge(myName, myYOB));
